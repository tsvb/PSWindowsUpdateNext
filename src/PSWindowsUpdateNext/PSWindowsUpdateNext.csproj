<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net472 loads in Windows PowerShell 5.1; net8.0-windows loads in PowerShell 7.4 and later. -->
    <TargetFrameworks>net472;net8.0-windows</TargetFrameworks>
    <AssemblyName>PSWindowsUpdateNext</AssemblyName>
    <RootNamespace>PSWindowsUpdateNext</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>3.2.0</Version>
    <AssemblyVersion>3.2.0.0</AssemblyVersion>
    <FileVersion>3.2.0.0</FileVersion>
    <Product>PSWindowsUpdateNext</Product>
    <Authors>Michal Gajda; tsvb</Authors>
    <Copyright>Copyright (c) 2011-2023 Michal Gajda. Modifications copyright (c) 2026 tsvb. MIT License.</Copyright>
    <Description>Cmdlets to manage the Windows Update client. Community-maintained continuation of PSWindowsUpdate.</Description>
    <!-- Static analysis. Per-rule severities live in the root .editorconfig;
         AnalysisLevel is pinned so a newer SDK cannot add rules and break the build without a code change. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>8.0</AnalysisLevel>
    <!-- Default mode: the rules Microsoft enables as build warnings because they find defects. On top of that,
         every security rule (CA2xxx/CA3xxx/CA5xxx) is enabled, because this module handles credentials, runs
         as SYSTEM, calls native APIs, and downloads and verifies files. The design, naming, globalization and
         performance categories stay off: on code recovered from a DLL they report style, not defects. -->
    <AnalysisMode>Default</AnalysisMode>
    <AnalysisModeSecurity>All</AnalysisModeSecurity>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CS1591: missing XML doc on public member (COM interop types). CA1416: platform check noise, the module is Windows-only by design. -->
    <NoWarn>$(NoWarn);CS1591;CA1416;SYSLIB0014</NoWarn>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference-only: System.Management.Automation is supplied by the host. -->
    <PackageReference Include="PowerShellStandard.Library" Version="5.1.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="System.Management" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="Microsoft.CSharp" />
    <!-- MMI ships with Windows PowerShell 5.1 (GAC); use the reference assembly from NuGet to compile. -->
    <PackageReference Include="Microsoft.Management.Infrastructure" Version="3.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <!-- PowerShell 7 ships all of these in $PSHOME, so they are compile-time only (ExcludeAssets=runtime). -->
    <PackageReference Include="System.Management" Version="8.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Management.Infrastructure" Version="3.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- The console's XAML ships inside the signed DLL; Show-PSWUConsole reads it with GetManifestResourceStream. -->
    <EmbeddedResource Include="Gui\MainWindow.xaml" LogicalName="PSWindowsUpdateNext.Gui.MainWindow.xaml" />
    <EmbeddedResource Include="Gui\Theme.xaml" LogicalName="PSWindowsUpdateNext.Gui.Theme.xaml" />
  </ItemGroup>

</Project>
