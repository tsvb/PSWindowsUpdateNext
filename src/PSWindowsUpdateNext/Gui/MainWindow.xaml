<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PSWindowsUpdateNext Console" Width="1380" Height="880" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#0B1220" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!--THEME-->
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0" Background="#0B1220">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource B.Accent}" Margin="0,0,10,0">
                    <TextBlock Text="&#xE895;" FontFamily="{StaticResource F.Icon}" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="PSWindowsUpdateNext" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="Console" Style="{StaticResource T.Muted}" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="BtnMin" Style="{StaticResource BtnCaption}" Content="&#xE921;" ToolTip="Minimize"/>
                <Button x:Name="BtnMax" Style="{StaticResource BtnCaption}" Content="&#xE922;" ToolTip="Maximize"/>
                <Button x:Name="BtnClose" Style="{StaticResource BtnCaptionClose}" Content="&#xE8BB;" ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Border Grid.Column="0" Background="{StaticResource B.RailGradient}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="20,18,20,14">
                        <TextBlock Style="{StaticResource T.Label}" Text="Computer"/>
                        <TextBlock x:Name="TxtComputer" Style="{StaticResource T.H2}" Text="—" Margin="0,2,0,0"/>
                        <TextBlock x:Name="TxtOs" Style="{StaticResource T.Muted}" Text="" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE80F;" Content="Dashboard" IsChecked="True"/>
                        <RadioButton x:Name="NavUpdates" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE895;" Content="Updates"/>
                        <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE81C;" Content="History"/>
                        <RadioButton x:Name="NavServices" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE968;" Content="Services"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE713;" Content="Settings"/>
                        <RadioButton x:Name="NavCatalog" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE896;" Content="Catalog"/>
                        <RadioButton x:Name="NavJobs" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE823;" Content="Jobs"/>
                        <RadioButton x:Name="NavLog" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE7C3;" Content="Log"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="14,0,14,16">
                        <Border x:Name="CardElevation" Style="{StaticResource Card}" Padding="14" CornerRadius="10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="DotElevation" Style="{StaticResource Dot}" Fill="{StaticResource B.Warning}" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtElevation" Text="Not elevated" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtElevationHint" Style="{StaticResource T.Muted}" Text="Scanning and installing need an administrator session." TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <Button x:Name="BtnElevate" Style="{StaticResource BtnPrimary}" Content="Run as administrator" Padding="10,7" Margin="0,10,0,0" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="TxtVersion" Style="{StaticResource T.Muted}" Text="" Margin="6,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ProgressBar x:Name="BusyBar" Grid.Row="0" IsIndeterminate="True" Visibility="Hidden"/>

                <!-- ===== Dashboard ===== -->
                <Grid x:Name="PageDashboard" Grid.Row="1" Margin="28,22,28,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}" Background="{StaticResource B.HeroGradient}" Padding="26,22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource T.Label}" Text="Windows Update status"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock x:Name="TxtHeroTitle" Style="{StaticResource T.H1}" Text="Checking…"/>
                                    <Border x:Name="BadgeReboot" Style="{StaticResource Badge}" Background="#33FF5C6C" Margin="14,0,0,0" Visibility="Collapsed">
                                        <TextBlock Text="Reboot required" Foreground="{StaticResource B.Danger}" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="TxtHeroSub" Style="{StaticResource T.Muted}" Text="" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <StackPanel Margin="0,0,34,0">
                                        <TextBlock Style="{StaticResource T.Label}" Text="Last search"/>
                                        <TextBlock x:Name="TxtLastSearch" Text="—" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,34,0">
                                        <TextBlock Style="{StaticResource T.Label}" Text="Last install"/>
                                        <TextBlock x:Name="TxtLastInstall" Text="—" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,34,0">
                                        <TextBlock Style="{StaticResource T.Label}" Text="Agent"/>
                                        <TextBlock x:Name="TxtAgent" Text="—" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource T.Label}" Text="Default service"/>
                                        <TextBlock x:Name="TxtDefaultService" Text="—" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button x:Name="BtnDashScan" Style="{StaticResource BtnPrimary}" Content="Scan for updates" MinWidth="180"/>
                                <Button x:Name="BtnDashInstallAll" Style="{StaticResource Btn}" Content="Install everything" Margin="0,8,0,0"/>
                                <Button x:Name="BtnDashReboot" Style="{StaticResource BtnDanger}" Content="Reboot now" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="-6,16,-6,0">
                        <Border Style="{StaticResource Card}" Margin="6,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource T.Label}" Text="Pending updates"/>
                                <TextBlock x:Name="MetricPending" Style="{StaticResource T.Metric}" Text="–"/>
                                <TextBlock x:Name="MetricPendingSub" Style="{StaticResource T.Muted}" Text="run a scan"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource T.Label}" Text="Downloaded"/>
                                <TextBlock x:Name="MetricDownloaded" Style="{StaticResource T.Metric}" Text="–" Foreground="{StaticResource B.Accent}"/>
                                <TextBlock Style="{StaticResource T.Muted}" Text="ready to install"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource T.Label}" Text="Hidden"/>
                                <TextBlock x:Name="MetricHidden" Style="{StaticResource T.Metric}" Text="–" Foreground="{StaticResource B.Muted}"/>
                                <TextBlock Style="{StaticResource T.Muted}" Text="excluded from install"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource T.Label}" Text="Installed, 30 days"/>
                                <TextBlock x:Name="MetricInstalled30" Style="{StaticResource T.Metric}" Text="–" Foreground="{StaticResource B.Success}"/>
                                <TextBlock x:Name="MetricFailed30" Style="{StaticResource T.Muted}" Text=""/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,8,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="18,14,18,10">
                                    <TextBlock Style="{StaticResource T.H2}" Text="Recent activity"/>
                                    <Button x:Name="BtnDashHistoryAll" Style="{StaticResource BtnGhost}" Content="Open history" HorizontalAlignment="Right" Padding="8,2"/>
                                </Grid>
                                <ScrollViewer Grid.Row="1" Style="{StaticResource ListHost}">
                                    <ItemsControl x:Name="ListDashHistory">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Row}" Padding="18,9">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Style="{StaticResource Dot}" Fill="{Binding ResultColor}" HorizontalAlignment="Left"/>
                                                        <StackPanel Grid.Column="1" Margin="4,0,12,0">
                                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Style="{StaticResource T.Muted}" Text="{Binding Operation}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Style="{StaticResource T.Muted}" Text="{Binding DateText}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource T.H2}" Text="Client configuration"/>
                                <ItemsControl x:Name="ListDashSettings" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource T.Muted}" Text="{Binding Name}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource T.Mono}" Text="{Binding Value}" Foreground="{StaticResource B.Text}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="TxtDashSettingsEmpty" Style="{StaticResource T.Muted}" Text="No Windows Update policies are set on this machine." Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== Updates ===== -->
                <Grid x:Name="PageUpdates" Grid.Row="1" Margin="28,22,28,20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource T.H1}" Text="Updates"/>
                            <TextBlock x:Name="TxtUpdatesSub" Style="{StaticResource T.Muted}" Text="Scan to list updates the Windows Update Agent can see."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBox x:Name="CmbSource" Width="170" Margin="0,0,8,0" SelectedIndex="0">
                                <ComboBoxItem Content="Default service"/>
                                <ComboBoxItem Content="Microsoft Update"/>
                                <ComboBoxItem Content="Windows Update"/>
                            </ComboBox>
                            <Button x:Name="BtnScan" Style="{StaticResource BtnPrimary}" Content="Scan"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,14,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBox x:Name="TxtUpdateFilter" Width="220" Margin="0,0,10,4" Tag="Filter by title or KB"/>
                            <ToggleButton x:Name="ChipHidden" Style="{StaticResource Chip}" Content="Include hidden" Margin="0,0,6,4"/>
                            <ToggleButton x:Name="ChipInstalled" Style="{StaticResource Chip}" Content="Installed" Margin="0,0,6,4"/>
                            <ToggleButton x:Name="ChipRebootOnly" Style="{StaticResource Chip}" Content="Needs reboot" Margin="0,0,6,4"/>
                        </WrapPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <CheckBox x:Name="SwAutoReboot" Style="{StaticResource Switch}" Content="Auto reboot" Margin="0,0,16,0"/>
                            <Button x:Name="BtnDownload" Style="{StaticResource Btn}" Content="Download" Margin="0,0,6,0"/>
                            <Button x:Name="BtnInstall" Style="{StaticResource BtnPrimary}" Content="Install selected" Margin="0,0,6,0"/>
                            <Button x:Name="BtnHide" Style="{StaticResource Btn}" Content="Hide" Margin="0,0,6,0"/>
                            <Button x:Name="BtnUnhide" Style="{StaticResource Btn}" Content="Unhide"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="{StaticResource B.Raised}" CornerRadius="12,12,0,0" Padding="14,8" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ChkSelectAll" Style="{StaticResource Check}"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource T.Label}" Text="KB"/>
                                        <TextBlock Grid.Column="2" Style="{StaticResource T.Label}" Text="Update"/>
                                        <TextBlock Grid.Column="3" Style="{StaticResource T.Label}" Text="Severity"/>
                                        <TextBlock Grid.Column="4" Style="{StaticResource T.Label}" Text="Size"/>
                                        <TextBlock Grid.Column="5" Style="{StaticResource T.Label}" Text="State"/>
                                    </Grid>
                                </Border>
                                <ScrollViewer Grid.Row="1" Style="{StaticResource ListHost}">
                                    <ItemsControl x:Name="ListUpdates" VirtualizingPanel.IsVirtualizing="True">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Row}" Tag="{Binding UpdateID}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="30"/>
                                                            <ColumnDefinition Width="96"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="100"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Selected, Mode=TwoWay}"/>
                                                        <Border Grid.Column="1" Style="{StaticResource Badge}" HorizontalAlignment="Left" Visibility="{Binding KBVisibility}">
                                                            <TextBlock Text="{Binding KB}" Style="{StaticResource T.Mono}" FontSize="11"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="2" Margin="6,0,12,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Style="{StaticResource T.Muted}" Text="{Binding Category}"/>
                                                                <TextBlock Style="{StaticResource T.Muted}" Text="  ·  "/>
                                                                <TextBlock Style="{StaticResource T.Muted}" Text="{Binding PublishedText}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Style="{StaticResource Dot}" Fill="{Binding SeverityColor}" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding Severity}" Style="{StaticResource T.Muted}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="4" Text="{Binding Size}" Style="{StaticResource T.Mono}" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="5" Style="{StaticResource Badge}" HorizontalAlignment="Left" Background="#1AFFFFFF">
                                                            <TextBlock Text="{Binding StateText}" Foreground="{Binding StateColor}" FontSize="11" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock x:Name="TxtUpdatesEmpty" Grid.Row="1" Style="{StaticResource T.Muted}" Text="No updates listed. Run a scan." HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border x:Name="PanelDetail" Grid.Column="1" Style="{StaticResource Card}" Width="340" Margin="14,0,0,0" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource T.Label}" Text="Selected update"/>
                                    <TextBlock x:Name="DetTitle" Style="{StaticResource T.H2}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,0,10"><TextBlock Style="{StaticResource T.Label}" Text="KB"/><TextBlock x:Name="DetKB" Style="{StaticResource T.Mono}"/></StackPanel>
                                        <StackPanel Margin="0,0,0,10"><TextBlock Style="{StaticResource T.Label}" Text="Size"/><TextBlock x:Name="DetSize" Style="{StaticResource T.Mono}"/></StackPanel>
                                        <StackPanel Margin="0,0,0,10"><TextBlock Style="{StaticResource T.Label}" Text="Severity"/><TextBlock x:Name="DetSeverity"/></StackPanel>
                                        <StackPanel Margin="0,0,0,10"><TextBlock Style="{StaticResource T.Label}" Text="Reboot"/><TextBlock x:Name="DetReboot"/></StackPanel>
                                        <StackPanel Margin="0,0,0,10"><TextBlock Style="{StaticResource T.Label}" Text="Published"/><TextBlock x:Name="DetPublished"/></StackPanel>
                                        <StackPanel Margin="0,0,0,10"><TextBlock Style="{StaticResource T.Label}" Text="State"/><TextBlock x:Name="DetState"/></StackPanel>
                                    </UniformGrid>
                                    <TextBlock Style="{StaticResource T.Label}" Text="Update ID"/>
                                    <TextBlock x:Name="DetId" Style="{StaticResource T.Mono}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <TextBlock Style="{StaticResource T.Label}" Text="Description"/>
                                    <TextBlock x:Name="DetDescription" TextWrapping="Wrap" Style="{StaticResource T.Muted}" Foreground="{StaticResource B.Text}" Margin="0,2,0,12"/>
                                    <Button x:Name="BtnMoreInfo" Style="{StaticResource Btn}" Content="Open support article" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== History ===== -->
                <Grid x:Name="PageHistory" Grid.Row="1" Margin="28,22,28,20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource T.H1}" Text="History"/>
                            <TextBlock x:Name="TxtHistorySub" Style="{StaticResource T.Muted}" Text="Operations recorded by the Windows Update Agent."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBox x:Name="TxtHistoryFilter" Width="220" Margin="0,0,8,0" Tag="Filter by title or KB"/>
                            <ComboBox x:Name="CmbHistoryCount" Width="110" Margin="0,0,8,0" SelectedIndex="1">
                                <ComboBoxItem Content="Last 25"/>
                                <ComboBoxItem Content="Last 50"/>
                                <ComboBoxItem Content="Last 100"/>
                                <ComboBoxItem Content="Last 250"/>
                                <ComboBoxItem Content="Last 1000"/>
                            </ComboBox>
                            <Button x:Name="BtnHistoryRefresh" Style="{StaticResource BtnPrimary}" Content="Refresh"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,14,0,0">
                        <ScrollViewer Style="{StaticResource ListHost}">
                            <ItemsControl x:Name="ListHistory">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Row}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DateText}" Style="{StaticResource T.Mono}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Style="{StaticResource Dot}" Fill="{Binding ResultColor}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Result}" FontWeight="SemiBold" Foreground="{Binding ResultColor}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Operation}" Style="{StaticResource T.Muted}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding KB}" Style="{StaticResource T.Mono}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ===== Services ===== -->
                <Grid x:Name="PageServices" Grid.Row="1" Margin="28,22,28,20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource T.H1}" Text="Update services"/>
                            <TextBlock Style="{StaticResource T.Muted}" Text="Service managers registered with the Windows Update Agent."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnServicesRefresh" Style="{StaticResource Btn}" Content="Refresh" Margin="0,0,8,0"/>
                            <Button x:Name="BtnAddMicrosoftUpdate" Style="{StaticResource BtnPrimary}" Content="Register Microsoft Update"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,14,0,0">
                        <ScrollViewer Style="{StaticResource ListHost}">
                            <ItemsControl x:Name="ListServices">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Row}" Padding="18,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.H2}" FontSize="14"/>
                                                        <Border Style="{StaticResource Badge}" Background="#1F2ECC8A" Margin="10,0,0,0" Visibility="{Binding DefaultVisibility}">
                                                            <TextBlock Text="Default" Foreground="{StaticResource B.Success}" FontSize="11" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Border Style="{StaticResource Badge}" Background="#1F4F8CFF" Margin="6,0,0,0" Visibility="{Binding ManagedVisibility}">
                                                            <TextBlock Text="Managed" Foreground="{StaticResource B.Accent}" FontSize="11" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ServiceID}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Muted}" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding ServiceUrl}" Style="{StaticResource T.Muted}"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Content="Remove" Tag="{Binding ServiceID}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ===== Settings ===== -->
                <Grid x:Name="PageSettings" Grid.Row="1" Margin="28,22,28,20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource T.H1}" Text="Client settings"/>
                            <TextBlock Style="{StaticResource T.Muted}" Text="Windows Update policies under HKLM\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate."/>
                        </StackPanel>
                        <Button x:Name="BtnSettingsRefresh" Style="{StaticResource Btn}" Content="Refresh" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="420"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,8,0">
                            <Grid>
                                <ScrollViewer Style="{StaticResource ListHost}">
                                    <ItemsControl x:Name="ListSettings">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Row}" Padding="18,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Accent}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock x:Name="TxtSettingsEmpty" Style="{StaticResource T.Muted}" Text="No policy values are set. Windows Update is using its defaults." HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource T.H2}" Text="Change policy"/>
                                    <TextBlock Style="{StaticResource T.Muted}" Text="Only the fields you touch are written. Requires an elevated session." TextWrapping="Wrap" Margin="0,4,0,14"/>
                                    <CheckBox x:Name="SwNoAutoUpdate" Style="{StaticResource Switch}" Content="Disable automatic updates (NoAutoUpdate)" Margin="0,0,0,12"/>
                                    <TextBlock Style="{StaticResource T.Label}" Text="Automatic update behavior (AUOptions)"/>
                                    <ComboBox x:Name="CmbAUOptions" Margin="0,4,0,12">
                                        <ComboBoxItem Content="Leave unchanged"/>
                                        <ComboBoxItem Content="2 – Notify before download"/>
                                        <ComboBoxItem Content="3 – Download, notify before install"/>
                                        <ComboBoxItem Content="4 – Download and schedule install"/>
                                        <ComboBoxItem Content="5 – Local admin chooses"/>
                                    </ComboBox>
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,6,12">
                                            <TextBlock Style="{StaticResource T.Label}" Text="Scheduled install day"/>
                                            <ComboBox x:Name="CmbInstallDay" Margin="0,4,0,0">
                                                <ComboBoxItem Content="Leave unchanged"/>
                                                <ComboBoxItem Content="0 – Every day"/>
                                                <ComboBoxItem Content="1 – Sunday"/>
                                                <ComboBoxItem Content="2 – Monday"/>
                                                <ComboBoxItem Content="3 – Tuesday"/>
                                                <ComboBoxItem Content="4 – Wednesday"/>
                                                <ComboBoxItem Content="5 – Thursday"/>
                                                <ComboBoxItem Content="6 – Friday"/>
                                                <ComboBoxItem Content="7 – Saturday"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Margin="6,0,0,12">
                                            <TextBlock Style="{StaticResource T.Label}" Text="Scheduled install hour (0-23)"/>
                                            <TextBox x:Name="TxtInstallHour" Margin="0,4,0,0" Tag="e.g. 3"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <CheckBox x:Name="SwTargetRelease" Style="{StaticResource Switch}" Content="Pin feature updates to a release" Margin="0,0,0,8"/>
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,6,12">
                                            <TextBlock Style="{StaticResource T.Label}" Text="Release (e.g. 23H2)"/>
                                            <TextBox x:Name="TxtTargetRelease" Margin="0,4,0,0" Tag="23H2"/>
                                        </StackPanel>
                                        <StackPanel Margin="6,0,0,12">
                                            <TextBlock Style="{StaticResource T.Label}" Text="Product (e.g. Windows 11)"/>
                                            <TextBox x:Name="TxtProductVersion" Margin="0,4,0,0" Tag="Windows 11"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,6,12">
                                            <TextBlock Style="{StaticResource T.Label}" Text="Defer quality updates (days)"/>
                                            <TextBox x:Name="TxtDeferQuality" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Margin="6,0,0,12">
                                            <TextBlock Style="{StaticResource T.Label}" Text="Defer feature updates (days)"/>
                                            <TextBox x:Name="TxtDeferFeature" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <Button x:Name="BtnApplySettings" Style="{StaticResource BtnPrimary}" Content="Apply changes" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== Catalog ===== -->
                <Grid x:Name="PageCatalog" Grid.Row="1" Margin="28,22,28,20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource T.H1}" Text="Update Catalog"/>
                            <TextBlock Style="{StaticResource T.Muted}" Text="Search catalog.update.microsoft.com and download verified offline packages."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBox x:Name="TxtCatalogKB" Width="180" Margin="0,0,8,0" Tag="KB number, e.g. 5062553"/>
                            <Button x:Name="BtnCatalogSearch" Style="{StaticResource BtnPrimary}" Content="Search"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,14,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Margin="0,0,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MaxWidth="420"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource T.Muted}" Text="Save to" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtCatalogDest" Grid.Column="1" Margin="0,0,6,0"/>
                            <Button x:Name="BtnCatalogBrowse" Grid.Column="2" Style="{StaticResource Btn}" Content="Browse…"/>
                        </Grid>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <CheckBox x:Name="SwSkipSignature" Style="{StaticResource Switch}" Content="Keep unsigned files" Margin="0,0,16,0"/>
                            <Button x:Name="BtnCatalogDownload" Style="{StaticResource BtnPrimary}" Content="Download selected"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource B.Raised}" CornerRadius="12,12,0,0" Padding="14,8" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkCatalogAll" Style="{StaticResource Check}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource T.Label}" Text="Package"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource T.Label}" Text="Product"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource T.Label}" Text="Classification"/>
                                    <TextBlock Grid.Column="4" Style="{StaticResource T.Label}" Text="Updated"/>
                                    <TextBlock Grid.Column="5" Style="{StaticResource T.Label}" Text="Size"/>
                                    <TextBlock Grid.Column="6" Style="{StaticResource T.Label}" Text="Result"/>
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="1" Style="{StaticResource ListHost}">
                                <ItemsControl x:Name="ListCatalog">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Row}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="110"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Selected, Mode=TwoWay}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Product}" Style="{StaticResource T.Muted}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Classification}" Style="{StaticResource T.Muted}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding LastUpdated}" Style="{StaticResource T.Mono}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding Size}" Style="{StaticResource T.Mono}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="6" Style="{StaticResource Badge}" HorizontalAlignment="Left" Background="{Binding ResultColor}">
                                                        <TextBlock Text="{Binding Result}" Foreground="#0B1220" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="TxtCatalogEmpty" Grid.Row="1" Style="{StaticResource T.Muted}" Text="Enter a KB number and search." HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== Jobs ===== -->
                <Grid x:Name="PageJobs" Grid.Row="1" Margin="28,22,28,20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource T.H1}" Text="Scheduled jobs"/>
                            <TextBlock Style="{StaticResource T.Muted}" Text="Task Scheduler jobs created by this module. They run as SYSTEM."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnJobsRefresh" Style="{StaticResource Btn}" Content="Refresh" Margin="0,0,8,0"/>
                            <Button x:Name="BtnJobsClear" Style="{StaticResource Btn}" Content="Clear expired"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="420"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,8,0">
                            <Grid>
                                <ScrollViewer Style="{StaticResource ListHost}">
                                    <ItemsControl x:Name="ListJobs">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Row}" Padding="18,12">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                            <Border Style="{StaticResource Badge}" Background="#1AFFFFFF" Margin="10,0,0,0">
                                                                <TextBlock Text="{Binding State}" Foreground="{Binding StateColor}" FontSize="11" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Style="{StaticResource T.Muted}" Text="Last run "/>
                                                            <TextBlock Style="{StaticResource T.Muted}" Text="{Binding LastRun}" Foreground="{StaticResource B.Text}"/>
                                                            <TextBlock Style="{StaticResource T.Muted}" Text="   ·   Next run "/>
                                                            <TextBlock Style="{StaticResource T.Muted}" Text="{Binding NextRun}" Foreground="{StaticResource B.Text}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock x:Name="TxtJobsEmpty" Style="{StaticResource T.Muted}" Text="No PSWindowsUpdateNext jobs are registered." HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource T.H2}" Text="New job"/>
                                <TextBlock Style="{StaticResource T.Muted}" Text="Runs in Windows PowerShell as SYSTEM via Task Scheduler. Use this to install updates that refuse to run over a remote session." TextWrapping="Wrap" Margin="0,4,0,14"/>
                                <TextBlock Style="{StaticResource T.Label}" Text="Task name"/>
                                <TextBox x:Name="TxtJobName" Text="PSWindowsUpdateNext" Margin="0,4,0,12"/>
                                <TextBlock Style="{StaticResource T.Label}" Text="Script"/>
                                <TextBox x:Name="TxtJobScript" Margin="0,4,0,12" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" FontFamily="{StaticResource F.Mono}" FontSize="12" VerticalContentAlignment="Top"/>
                                <TextBlock Style="{StaticResource T.Label}" Text="Trigger"/>
                                <ComboBox x:Name="CmbJobTrigger" Margin="0,4,0,8" SelectedIndex="0">
                                    <ComboBoxItem Content="Run now"/>
                                    <ComboBoxItem Content="At next startup"/>
                                    <ComboBoxItem Content="At a specific time"/>
                                </ComboBox>
                                <TextBox x:Name="TxtJobTime" Margin="0,0,0,12" Tag="yyyy-MM-dd HH:mm" IsEnabled="False"/>
                                <Button x:Name="BtnJobCreate" Style="{StaticResource BtnPrimary}" Content="Create job" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== Log ===== -->
                <Grid x:Name="PageLog" Grid.Row="1" Margin="28,22,28,20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource T.H1}" Text="Activity log"/>
                            <TextBlock Style="{StaticResource T.Muted}" Text="Verbose, warning, and error output from every operation this session."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnLogCopy" Style="{StaticResource Btn}" Content="Copy" Margin="0,0,8,0"/>
                            <Button x:Name="BtnLogSave" Style="{StaticResource Btn}" Content="Save…" Margin="0,0,8,0"/>
                            <Button x:Name="BtnLogClear" Style="{StaticResource BtnGhost}" Content="Clear"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,14,0,0" Background="#0A0F1B">
                        <ScrollViewer x:Name="LogScroll" Style="{StaticResource ListHost}">
                            <ItemsControl x:Name="ListLog" Margin="12,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Muted}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Level}" Style="{StaticResource T.Mono}" Foreground="{Binding Color}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" Style="{StaticResource T.Mono}" Foreground="{Binding Color}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#0A0F1B" BorderBrush="{StaticResource B.Border}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="DotStatus" Style="{StaticResource Dot}" Fill="{StaticResource B.Success}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtStatus" Style="{StaticResource T.Muted}" Text="Ready"/>
                    <TextBlock x:Name="TxtProgress" Style="{StaticResource T.Muted}" Text="" Margin="14,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="TxtEdition" Style="{StaticResource T.Muted}" Text="" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
